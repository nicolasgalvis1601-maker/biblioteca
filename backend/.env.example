DATABASE_URL=mysql+pymysql://biblioteca11:change-me@localhost:3306/biblioteca?charset=utf8mb4
TEST_DATABASE_URL=sqlite+pysqlite:///./biblioteca_test.db
SECRET_KEY=replace_with_output_of_python_secrets_token_urlsafe_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENVIRONMENT=dev
MYSQL_DATABASE=biblioteca
MYSQL_USER=biblioteca11
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Cloudinary Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Producción (servidor) ----
# ENVIRONMENT=prod oculta /docs y rechaza CORS con "*".
# CORS_ORIGINS debe ser la dirección exacta de tu página, p. ej. ["https://mi-biblioteca.onrender.com"]
# Base de datos en la nube: usa la cadena de conexión de tu proveedor, con el prefijo mysql+pymysql://
# Si exige SSL (p. ej. TiDB Cloud), agrega al final de DATABASE_URL:
#   ?ssl_ca=/etc/ssl/certs/ca-certificates.crt&ssl_verify_cert=true&ssl_verify_identity=true
